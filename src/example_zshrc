autoload -U add-zsh-hook

prompt_bort_chpwd() {}

prompt_bort_precmd() {
    DIR=$(pwd)
    TERMINAL_WIDTH=$(tput cols)
    PROMPT='$(~/projects/bort/target/debug/bort prompt --dir="$DIR" --terminal-width=$TERMINAL_WIDTH)'
}

add-zsh-hook chpwd prompt_bort_chpwd
add-zsh-hook precmd prompt_bort_precmd

