autoload -U add-zsh-hook

prompt_bort_chpwd() {}

prompt_bort_precmd() {
    DIR=$(pwd)
    PROMPT='$(~/projects/bort/target/debug/bort prompt --dir="$DIR")'
    RPROMPT='$(~/projects/bort/target/debug/bort prompt --right)'
}

add-zsh-hook chpwd prompt_bort_chpwd
add-zsh-hook precmd prompt_bort_precmd

